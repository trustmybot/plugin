# esbuild preserves whitespace inside generated template-literal source. Treat
# the checked-in bundles as generated artifacts so git diff --check does
# not require a semantics-changing post-build whitespace rewrite.
mcp/trajectory-server/dist/index.js -whitespace
mcp/trajectory-server/dist/codex.js -whitespace
mcp/trajectory-server/dist/hooks.js -whitespace
mcp/trajectory-server/dist/run-scan.js -whitespace
mcp/trajectory-server/dist/cli.js -whitespace

# Generated artefacts: a merge keeps ours and names the file; rebuild them all
# with `node --experimental-strip-types scripts/maintenance/regen-generated.ts`
# after the merge. The driver lives in .git/config — `node
# mcp/trajectory-server/dist/hooks.js install-merge-driver` (run in-process by
# the WorktreeCreate hook). docs/contributing/ENUMS.md stays text-merged: only one
# section of it is generated, and the regen script rewrites that section.
# dashboard/dist/** is the dashboard build, which bundles trajectory-server
# sources, so the regen script rebuilds it after the server.
mcp/trajectory-server/dist/** merge=tmb-regen
dashboard/dist/** merge=tmb-regen
scripts/hooks/lib/audit-events.txt merge=tmb-regen
scripts/hooks/lib/data-contracts.json merge=tmb-regen
