{
  "name": "@trustmybot/trajectory-server",
  "version": "0.10.0-rc.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "rm -rf dist/test",
    "build:tsc": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:kuzu --external:@huggingface/transformers --outfile=dist/index.js --sourcemap",
    "build": "bun run build:tsc && bun run build:bundle && cp src/schema*.sql dist/",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite --test dist/test/*.test.js",
    "pretest": "bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0",
    "kuzu": "^0.11"
  },
  "devDependencies": {
    "typescript": "^5.4",
    "@types/node": "^22.0",
    "esbuild": "^0.24"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "kuzu"
  ]
}
