          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" no-remote-auth-guard",
            "timeout": 6,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" remote-id-guard",
            "timeout": 6,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" agent-spawn-dispatch",
            "timeout": 16,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" swe-resume-gate",
            "timeout": 6,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*trajectory-server__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" trajectory-gates",
            "timeout": 1842,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/dispatch.sh\" askuserquestion-length-lint",
            "timeout": 6
