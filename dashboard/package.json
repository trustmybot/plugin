{
  "name": "@trustmybot/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs && cp ../mcp/trajectory-server/src/schema.sql ../mcp/trajectory-server/src/schema-eval.sql dist/",
    "build:web": "rm -rf dist/web && mkdir -p dist/web && cp web/index.html dist/web/ && esbuild web/main.tsx --bundle --minify --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --splitting --outdir=dist/web --entry-names=app --chunk-names=chunks/[name]-[hash] && tailwindcss -i web/styles.css -o dist/web/app.css --minify",
    "build": "tsc --noEmit && bun run build:server && bun run build:web",
    "start": "node dist/server.mjs",
    "dev": "node scripts/dev.mjs",
    "tokens": "node scripts/primer-tokens.mjs"
  },
  "devDependencies": {
    "@primer/octicons-react": "19.15.0",
    "@primer/primitives": "11.10.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@visx/axis": "4.0.0",
    "@visx/brush": "4.0.0",
    "@visx/glyph": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
