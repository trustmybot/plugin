{"src":"t101-review1","cmd":"python3 -c \"import os; os.path.os.chmod('/etc/x', 0o777)\"","expect":"fail_closed","note":"B1: a module os.path re-exports, reached past the safe module"}
{"src":"t101-review1","cmd":"python3 -c \"from os.path import os as o; o.chmod('/etc/x', 0o777)\"","expect":"fail_closed","note":"B1: an alias of a module re-exported through a safe module"}
{"src":"t101-review1","cmd":"python3 -c \"import os.path as p; p.os.chmod('/etc/x', 0o777)\"","expect":"fail_closed","note":"B1: a safe-module alias reaching its re-exported module"}
{"src":"t101-review1","cmd":"python3 -c \"import os; os.path.genericpath.os.chmod('/etc/x', 0o777)\"","expect":"fail_closed","note":"B1: a submodule chain under a safe module"}
{"src":"t101-review1","cmd":"python3 -c \"import os; os.path.os.chown('/etc/x', 0, 0)\"","expect":"fail_closed","note":"B1: chown through os.path.os"}
{"src":"t101-review1","cmd":"python3 -c \"import os; os.path.os.utime('/etc/x')\"","expect":"fail_closed","note":"B1: utime through os.path.os"}
{"src":"t101-review1","cmd":"python3 -c \"import os; os.path.os.putenv('X', 'y')\"","expect":"fail_closed","note":"B1: putenv through os.path.os"}
{"src":"t101-review1","cmd":"python3 -c \"import json; json.codecs.open('/etc/x', 'w').write('x')\"","expect":"fail_closed","note":"B1: a module json imports, reached past json"}
{"src":"t101-review1","cmd":"python3 -c \"import re; e = re.enum; print(e)\"","expect":"fail_closed","note":"B1: a module re imports, held as a value"}
{"src":"t101-review1","cmd":"ruby -e '1.send(:system, \"chmod 777 /etc/x\")'","expect":"fail_closed","note":"B2: a method call on a number literal"}
{"src":"t101-review1","cmd":"ruby -e '1.public_send(:system, \"chmod 777 /etc/x\")'","expect":"fail_closed","note":"B2: public_send on a number literal"}
{"src":"t101-review1","cmd":"ruby -e '1.instance_eval(\"system %q(chmod 777 /etc/x)\")'","expect":"fail_closed","note":"B2: instance_eval on a number literal"}
{"src":"t101-review1","cmd":"ruby -e '1.5.send(:system, \"chmod 777 /etc/x\")'","expect":"fail_closed","note":"B2: a method call on a float literal"}
{"src":"t101-review1","cmd":"python3 -c \"import os; print(os.path.join('a', 'b'))\"","expect":"empty","note":"a listed os.path function"}
{"src":"t101-review1","cmd":"python3 -c \"import datetime; print(datetime.datetime.now())\"","expect":"empty","note":"one public attribute past a listed datetime class"}
{"src":"t101-review1","cmd":"python3 -c \"from datetime import datetime; print(datetime.now())\"","expect":"empty","note":"a listed datetime class imported by name"}
{"src":"t101-review1","cmd":"python3 -c \"import math; print(math.sqrt(2))\"","expect":"empty","note":"a math function"}
{"src":"t101-review1","cmd":"ruby -e 'puts 1.5'","expect":"empty","note":"a float literal still lexes as one number"}
{"src":"t101-review1","cmd":"perl -e 'print for 1..3'","expect":"empty","note":"a perl range still lexes"}
