    {
      "name": "cost within budget",
      "scorer": "cost",
      "config": {
        "cost-budget.json": {
          "max_tokens_total": 20,
          "max_duration_ms": 50
        }
      },
      "events": [
        {
          "type": "assistant",
          "message": {
            "usage": {
              "input_tokens": 10,
              "output_tokens": 5
            }
          }
        },
        {
          "type": "result",
          "duration_ms": 40
