{
  "source": "trustmybot/plugin@9cc886e81bab51eb26ee83807f85e45caecd7c27 tests/l5-l6/lib/scorers.sh",
  "cases": [
    {
      "name": "outcome absent",
      "scorer": "outcome",
      "expected": {
        "status": 0,
        "stdout": "  ⊘ outcome scorer skipped: <scorer-dir>/outcome.sql not found\n",
        "stderr": ""
      }
    },
    {
      "name": "outcome pass multiple statements",
      "scorer": "outcome",
      "config": {
        "outcome.sql": "SELECT 1 AS pass, 'first; statement' AS description; SELECT 1 AS pass, 'second' AS description;"
      },
      "expected": {
        "status": 0,
        "stdout": "  ✓ outcome: 2/2 assertions passed\n",
        "stderr": ""
      }
    },
    {
      "name": "outcome failed later statement",
      "scorer": "outcome",
      "config": {
        "outcome.sql": "SELECT 1 AS pass, 'yes' AS description; SELECT 0 AS pass, 'no' AS description;"
      },
      "expected": {
        "status": 1,
        "stdout": "",
        "stderr": "  ✗ outcome: 1/2 assertions passed; failed: ; no\n"
      }
    },
    {
      "name": "outcome no rows",
      "scorer": "outcome",
      "config": {
        "outcome.sql": "SELECT 1 AS pass WHERE 0;"
      },
      "expected": {
        "status": 1,
        "stdout": "  ✗ outcome scorer: SQL returned no rows (expected ≥1 assertion)\n",
        "stderr": ""
      }
    },
