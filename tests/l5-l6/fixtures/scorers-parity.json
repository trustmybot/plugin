      ],
      "expected": {
        "status": 0,
        "stdout": "  ✓ cost: within budget — tokens_total=15 (in=10 out=5) duration_ms=40\n",
        "stderr": ""
      }
    },
    {
      "name": "cost soft budget",
      "scorer": "cost",
      "config": {
        "cost-budget.json": {
          "max_tokens_total": 10,
          "max_duration_ms": 20
