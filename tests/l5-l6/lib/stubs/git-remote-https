#!/usr/bin/env node
// tmb sandbox: git-remote-https stub. Blocks HTTPS git transport.
const { readFileSync } = require('node:fs');
if (!process.stdin.isTTY) {
  try {
    readFileSync(0);
  } catch {}
}
process.stderr.write(
  [
    'tmb sandbox: HTTPS git transport disabled in sandbox.',
    'Reason: prevents accidental real-remote git push/fetch.',
    `For git remote tests, use: $TMB_TEST_REMOTE = ${process.env.TMB_TEST_REMOTE || '<not set>'}`,
    `Attempted: git-remote-https ${process.argv.slice(2).join(' ')}`,
  ].join('\n') + '\n',
);
process.exitCode = 1;
