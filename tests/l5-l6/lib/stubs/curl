#!/usr/bin/env node
// tmb sandbox: curl stub. Blocks outbound HTTP requests.
const { readFileSync } = require('node:fs');
if (!process.stdin.isTTY) {
  try {
    readFileSync(0);
  } catch {}
}
process.stderr.write(
  [
    'tmb sandbox: curl disabled in test mode.',
    'Reason: prevents accidental outbound network requests.',
    `Attempted: curl ${process.argv.slice(2).join(' ')}`,
  ].join('\n') + '\n',
);
process.exitCode = 1;
