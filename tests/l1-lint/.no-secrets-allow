# Allowlist for no-secrets-in-source.sh.
# Format: path:line-pattern (one entry per line; # = comment).
# A finding is suppressed when its "file:line: matched-text" output contains
# both the path portion (before the first ':') and the pattern portion.

# plugin_config key literals, not secrets — config keys named in the
# label-config tests (issues.test / schema.test, src + built dist). The P_GENERIC
# "key '...'" rule flags the literal; these are public config-key names.
mcp/trajectory-server:key: 'issue_classification_labels'
mcp/trajectory-server:key: 'issue_priority_labels'
