# Allowlist for no-secrets-in-source.sh.
# Format: path:line-pattern (one entry per line; # = comment).
# A finding is suppressed when its "file:line: matched-text" output contains
# both the path portion (before the first ':') and the pattern portion.

# plugin_config key literals, not secrets — config keys named in src/tests
# (SQL `WHERE key = '<config_key>'` lookups + label-config tests, src + built
# dist). The P_GENERIC "key = '...'" rule flags the literal; these are public
# config-key names.
mcp/trajectory-server:'issue_classification_labels'
mcp/trajectory-server:'issue_priority_labels'
mcp/trajectory-server:'tmb_active_milestone'
mcp/trajectory-server:'headless_enforcement'
scripts/hooks/prompt-intent-hints.sh:'headless_enforcement'

# Public config-key and column names, not secrets: the verification_timeout_s
# plugin_config key (swe-verification-gate src + built dist) and the
# cache_creation_tokens agent_runs column the dashboard renders (src + dist).
mcp/trajectory-server:'verification_timeout_s'
dashboard/web/views/tasks/sections.tsx:'cache_creation_tokens'
dashboard/dist/web/app.js:"cache_creation_tokens"
