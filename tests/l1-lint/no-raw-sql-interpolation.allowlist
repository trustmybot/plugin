# Allowlist for no-raw-sql-interpolation.test.mjs lint.
# Entries: <file>@<function> (the function's current lines), <file>:<line>,
# or <file> (whole file). Prefer <file>@<function>: a line number goes stale
# when the file shifts. Add entries here when a site is reviewed and confirmed safe.

# query-task.sh tmb_gate_read and tmb_sqlite_ro: $sql is the helper's
# whole-statement parameter; sanitization is the CALLER's job and call sites
# are this lint's subjects.
scripts/hooks/lib/query-task.sh@tmb_gate_read
scripts/hooks/lib/query-task.sh@tmb_sqlite_ro
