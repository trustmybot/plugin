{
  "steps": [
    { "chain_setup_command": "git ls-tree -r --name-only HEAD | grep -x 'src/cli.py' >/dev/null && echo found" },
    { "chain_setup_command": "grep -q 'src/cli.py' files.txt || git checkout -q main" },
    { "chain_setup_command": "true || grep -q x files.txt" },
    { "chain_setup_command": "seq 1 100000 | grep --fixed-strings '5' >/dev/null && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep -e '^5$' -x >/dev/null && echo found" }
  ]
}
