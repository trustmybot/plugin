{
  "steps": [
    { "chain_setup_command": "git ls-tree -r --name-only HEAD | grep -qx 'src/cli.py' && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep -q '^5$' && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep --fixed-strings -q '5' && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep -e '^5$' -q && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep -Eq '^5$' && echo found" },
    { "chain_setup_command": "seq 1 100000 | grep --quiet '^5$' && echo found" }
  ]
}
